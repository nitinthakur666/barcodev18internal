<odoo>
    <record id="view_partner_form_bci" model="ir.ui.view">
        <field name="name">res.partner.form.bci</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street2']" position="after">
                <field name="street3" placeholder="Street 3..." class="o_address_street" readonly="type == 'contact' and parent_id != False"/>
                <field name="street4" placeholder="Street 4..." class="o_address_street" readonly="type == 'contact' and parent_id != False"/>
            </xpath>
            <xpath expr="//div[@name='vat_vies_container']" position="after">
                <field name="bci_code" readonly="1" force_save="1" invisible="not is_company"/>
                <field name="bci_site_code" invisible="bci_contact_type != 'Site'"/>
                <field name="bci_legal_name"/>
                <field name="bci_legacy_customer_id"/>
                <field name="bci_survey_id"/>
                <field name="bci_contact_type" invisible="not is_company"/>
                <field name="bci_national_account_no" readonly="bci_contact_type != 'Parent Company'" invisible="not is_company" force_save="1"/>
                <field name="bci_parent_company" readonly="bci_contact_type != 'Company'" invisible="not is_company" domain="[('bci_contact_type', '=', 'Parent Company')]" force_save="1" groups="barcode_india.group_barcode_india_na"/>
                <field name="bci_company" readonly="bci_contact_type != 'Site'" required="bci_contact_type == 'Site'" invisible="not is_company" domain="[('bci_contact_type', '=', 'Company')]" force_save="1"/>
                <field name="bci_site" readonly="bci_contact_type != 'Plant'" required="bci_contact_type == 'Plant'" domain="[('bci_contact_type', '=', 'Site')]" force_save="1"/>
                <field name="bci_region_user" invisible="is_company"/>
                <field name="bci_vertical" invisible="not is_company"/>
                <field name="bci_sub_vertical" invisible="not is_company" domain="[('vertical_id','=',bci_vertical)]"/>
                <field name="bci_sub_vertical_category" invisible="not is_company" domain="[('sub_vertical_id','=',bci_sub_vertical)]"/>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="bci_linkedin" widget="url" invisible="is_company"/>
                <field name="bci_turnover" invisible="not is_company"/>
                <field name="bci_any_other_info" invisible="not is_company"/>
                <field name="bci_department" invisible="is_company"/>
                <field name="bci_account_type" invisible="not is_company" required="bci_contact_type == 'Company'"/>
                <field name="bci_group_code" invisible="not is_company" required="bci_contact_type in ['Parent Company','Company']"/>
                <field name="bci_tax_group" invisible="not is_company" required="bci_contact_type == 'Company'"/>
                <field name="bci_terms_code" invisible="not is_company" required="bci_contact_type == 'Company'"/>
                <field name="bci_outstanding_balance_exceed" invisible="not is_company"/>
                <field name="bci_outstanding_balance" invisible="not is_company"/>
            </xpath>

            <xpath expr="//span[@name='address_name']" position="inside">
                <b invisible="type != 'site'">Site</b>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
               <field name="bci_child_company_ids" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_legacy_sopf" title="Legacy SOPF Header" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="bci_legacy_sopf_items_count == 0 or not is_company">
                    <field name="bci_legacy_sopf_count" string="L-SOPF Hdr" widget="statinfo"/>
                </button>
                <button name="action_view_legacy_sopf_items" title="Legacy SOPF Items" type="object" class="oe_stat_button" icon="fa-list-alt" invisible="bci_legacy_sopf_items_count == 0 or not is_company">
                    <field name="bci_legacy_sopf_items_count" string="L-SOPF Itm" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" name="action_view_child_company" icon="fa-user" type="object" invisible="bci_child_company_count == 0">
                    <field name="bci_child_company_count" string="Child Companies" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" name="action_view_site" icon="fa-user" type="object" invisible="bci_site_count == 0">
                    <field name="bci_site_count" string="Site" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" name="action_view_plant" icon="fa-user" type="object" invisible="bci_plant_count == 0">
                    <field name="bci_plant_count" string="Plant" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" name="action_view_contracts" icon="fa-usd" type="object" invisible="bci_contract_count == 0">
                    <field name="bci_contract_count" string="Contracts" widget="statinfo" />
                </button>
                <button class="oe_stat_button" name="action_view_assets" icon="fa-usd" type="object" invisible="bci_assets_count == 0">
                    <field name="bci_assets_count" string="Assets" widget="statinfo" />
                </button>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sla_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//field[@name='sla_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pricing Term" name="pricing_term">
                    <field name="bci_pricing_terms">
                        <list>
                            <field name="bci_quote_type" />
                            <field name="bci_pt_line_ids" widget="many2many_tags"/>
                        </list>
                        <form>
                            <group>
                                <field name="bci_quote_type" />
                            </group>
                            <notebook>
                                <page string="Payment Term Lines" name="paymet_term_line">
                                    <field name="bci_pt_line_ids">
                                        <list editable="bottom">
                                            <field name="name" />
                                            <field name="sequence" invisible="1" />
                                            <field name="bci_percentage" />
                                            <field name="bci_customer_pt_master_id" invisible="1" />
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </form>
                    </field>
                </page>
            </xpath>

            <xpath expr="//notebook//page[@name='sales_purchases']//group[@name='container_row_2']" position="inside">
                <group string="Customer Type&amp;Category" name="customer_type_category" priority="6">
                    <field name="bci_customer_type" />
                    <field name="bci_customer_category" />
                </group>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning oe_edit_only" role="alert" invisible="bci_parent_company == False">
                    Please Update NA with the <field name="bci_code" readonly="1"/> ERP Code in ERP.
                </div>
            </xpath>

        </field>
    </record>
</odoo>