<odoo>
    <data>
        
        <record id="product_category_form_view_barcode" model="ir.ui.view">
            <field name="name">product.category.form.barcode</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='first']" position="inside">
                    <field name="bci_code" class="oe_inline"/>
                    <field name="bci_pm" class="oe_inline"/>
                </xpath>
            </field>
        </record>    
    </data>
</odoo>