<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_assets_stage" model="ir.actions.act_window">
        <field name="name">Assets Stage</field>
        <field name="res_model">barcode_india.assets.stage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Assets Stage
                </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_assets_stage_tree">
        <field name="name">Assets Stage</field>
        <field name="model">barcode_india.assets.stage</field>
        <field name="arch" type="xml">
            <list string="Assets Stage" editable="bottom">
                <field name="name"/>
                <field name="type" required="1"/>
                <field name="sequence"/>
            </list>
        </field>
    </record>
</odoo>