<odoo>
    <record model="ir.ui.view" id="ssms_sale_order_inherit">
        <field name="name">Sale order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][4]" position="attributes">
                <attribute name="attrs">{'invisible': [('bci_stage', '!=', 'approved')]}</attribute>
            </xpath>
        
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button string="Send for Approval" name="send_for_approval" type="object" class="oe_highlight" attrs="{'invisible': ['|',('bci_stage','in',['draft','pricing_request','pending_approval','approved','rejected']),('state', '=', 'cancel')]}"/>
                <button string="Send For Pricing" name="action_send_for_pricing" type="object" class="oe_highlight" attrs="{'invisible':['|','|','|',('bci_stage','in',['pricing_updated','pricing_request','pending_approval','approved','rejected']),('is_send_for_pricing','=',False),('state', '=', 'cancel'),('bci_is_estimation','=',True)]}"/>
                <button string="Add Freight and Installation" type="object" name="action_freight_and_installation" attrs="{'invisible':['|','|',('bci_stage','in',['draft','pricing_request','pending_approval','approved','rejected']),('bci_is_estimation','=',True),('state', '=', 'cancel')]}"/>
                <button string="Create SOPF" name="view_bci_create_sopf_form" type="object" class="oe_highlight" attrs="{'invisible': ['|','|',('bci_stage', '!=','approved'),('state','in',['sale','done','cancel','SOPF']),('is_sopf_button_visible', '=', False)]}"/>
                <button name="action_create_new_quotation" string="Create New Version" type="object" attrs="{'invisible': ['|',('bypass_quote', '=', True),('state','in',['sale','done','cancel','SOPF'])]}"/>
                <button string="Re-Price" name="view_bci_sales_repricing_form" type="object" attrs="{'invisible': ['|',('state', '=', 'cancel'),('bci_stage', 'in',['pending_approval','approved','SOPF'])]}"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="bci_helpdesk"/>
                <field name="partner_credit_limit" />
                <field name="partner_outstanding_balance" />
                <field name="bci_user_role" invisible="1"/>
                <field name="bci_exchange_threshold" invisible="1"/>
                <field name="bci_cost_diff_threshold" invisible="1"/>
                <field name="bypass_quote" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <field name="bci_is_low_value_order" invisible="1"/>
                <field name="bci_is_cost_sheet_final" attrs="{'readonly': [('bci_stage', '=', 'approved')]}" invisible="1"/>
                <field name="approval_approvers_ids" widget="many2many_tags" invisible="1"/>
                <field name="bci_margin_approver" widget="many2many_tags" invisible="1"/>
                <field name="is_approver" invisible="1"/>
                <field name="bci_installation_type" attrs="{'readonly': [('bci_stage', '=', 'approved')]}"/>
                <field name="bci_freight_type" attrs="{'readonly': [('bci_stage', '=', 'approved')]}"/>
                <field name="bci_installation_amount" />
                <field name="bci_freight_amount" />
                
            </xpath>
            <xpath expr="//group[@name='order_details']" position="after">
                <group string="Special Condition" name="special_conditions">
                    <field name="bci_bg_pg" attrs="{'readonly': [('bci_stage', '=', 'approved')]}"/>
                    <field name="bci_payment_period" attrs="{'readonly': [('bci_stage', '=', 'approved')]}"/>
                    <field name="bci_ld_clause" attrs="{'readonly': [('bci_stage', '=', 'approved')]}"/>
                </group>
                <group string="Status" name="status">
                    <field name="bci_deal_margin" force_save="1"/>
                    <field name="bci_auto_approval" />
                    <field name="bci_stage" readonly="1"/>
                    <field name="bci_pt_approval" readonly="1"/>
                    <field name="bci_margin_approval" readonly="1"/>
                    <field name="bci_special_approval" readonly="1"/>
                    <field name="bci_validity_expired" readonly="1"/>
                    <field name="bci_exchange_expired" readonly="1"/>
                    <field name="bci_cost_expired" readonly="1"/>
                    <field name="is_send_for_pricing" invisible="1"/>
                    <field name="bci_is_estimation" invisible="1"/>
                    <field name="bci_presales_ids" widget="many2many_tags" invisible="1"/>
                    <field name="is_sopf_button_visible" invisible="1"/>
                </group>
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('bci_payment_period', '=', 'within_45_days')]}">
                    <field name="check_payment_message" attrs="{'invisible': [('bci_payment_period', '=', 'within_45_days')]}" readonly="1" nolabel="1"/>
                </div>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')]}</attribute>
            </field>
            <field name="partner_invoice_id" position="attributes">
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')]}</attribute>
            </field>

            <field name="sale_order_template_id" position="attributes">
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')]}</attribute>
            </field>

            <field name="partner_shipping_id" position="attributes">
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')]}</attribute>
            </field>
            <field name="validity_date" position="attributes">
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')]}</attribute>
            </field>

            <field name="date_order" position="attributes">
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')], 'invisible': [('state', 'in', ['sale', 'done', 'cancel'])]}</attribute>
            </field>
            <field name="pricelist_id" position="attributes">
                <attribute name="attrs">{'readonly': [('bci_stage', '=', 'approved')]}</attribute>
            </field>
            <xpath expr="//div[@class='oe_button_box']" position="after">
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('bci_validity_expired', '=', False)]}">
                    <field name="validity_expired_message" attrs="{'invisible': [('bci_validity_expired', '=', False)]}" />
                </div>
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('bci_exchange_expired', '=', False)]}">
                    <field name="exchange_expired_message" attrs="{'invisible': [('bci_exchange_expired', '=', False)]}" />
                </div>
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('bci_cost_expired', '=', False)]}">
                    <field name="cost_expired_message" attrs="{'invisible': [('bci_cost_expired', '=', False)]}" />
                </div>
            </xpath>
            <xpath expr="//notebook" position="before">
                
                <group string="Printout Type" name="print_out_type" >
                    <field name="bci_printout_type"/>
                    <field name="bci_show_optional"/>
                </group>
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('bci_quote_type', '!=', False)]}">
                    <group>
                        <field name="check_quote_type_message" attrs="{'invisible': [('bci_quote_type', '!=', False)]}" readonly="1"/>
                    </group>
                </div>
            </xpath>
            <xpath expr="//field[@name='picking_policy']" position="after">
                <field name="bci_location" required="1"/>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="before">
                <field name="bci_version" readonly="1" groups="base.group_no_one"/>
                <field name="bci_quote_type" required="1" attrs="{'readonly': [('bci_stage', '=', 'approved')]}"/>
                <field name="bci_readonly_fields" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                <button type="object" name="action_view_cost_sheet" string="Cost Sheet" class="oe_stat_button" icon="fa-puzzle-piece" attrs="{'invisible': [('bypass_quote', '=', True)]}"/>
                <button type="object" name="action_view_approval" string="Approvals" class="oe_stat_button" icon="fa-check" attrs="{'invisible': [('bypass_quote', '=', True)]}"/>
                <button type="object" name="action_view_sopf_order" string="SOPF" class="oe_stat_button" icon="fa-list" attrs="{'invisible': [('bci_sopf_count', '=', 0)]}">
                    <field name="bci_sopf_count" string="SOPF" widget="statinfo" />
                </button>
            </xpath>

            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Costing" name="Costing" groups="base.group_no_one">
                    <group>
                        <field name="bci_exchange_threshold" />
                        <field name="bci_cost_diff_threshold" />
                    </group>
                </page>
                <page string="Payment Milestone" name="payment_terms" attrs="{'invisible': [('bypass_quote', '=', True)]}">
                    <field name="bci_payment_terms" attrs="{'readonly': [('bci_stage', 'in', ['approved', 'pending_approval'])]}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="percentange" />
                            <field name="order_id" invisible="1" />
                            <field name="bci_is_approved" invisible="1" />
                        </tree>
                    </field>
                </page>
                <page name="sopf" string="SOPF" attrs="{'invisible': [('bci_sopf_count', '!=', 0)]}">
                    <group col="2">
                        <group>
                            <field name="sopf_order" invisible="1" readonly="1"/>
                            <!-- <field name="purchase_contact" options="{'no_create':True}" domain="[('parent_id', '=', partner_id)]" attrs="{'readonly': [('state','in',['sale','done'])]}"/>
                            <field name="finance_contact" options="{'no_create':True}" domain="[('parent_id', '=', partner_id)]" attrs="{'readonly': [('state','in',['sale','done'])]}"/>
                            <field name="store_contact" options="{'no_create':True}" domain="[('parent_id', '=', partner_id)]" attrs="{'readonly': [('state','in',['sale','done'])]}"/> -->
                            <field name="purchase_contact_name" readonly="1"/>
                            <field name="purchase_contact_email" readonly="1"/>
                            <field name="purchase_contact_phone" readonly="1"/>
                            <field name="finance_contact_name" readonly="1"/>
                            <field name="finance_contact_email" readonly="1"/>
                            <field name="finance_contact_phone" readonly="1"/>
                            <field name="store_contact_name" readonly="1"/>
                            <field name="store_contact_email" readonly="1"/>
                            <field name="store_contact_phone" readonly="1"/>
                            <field name="bci_delivery_schedule" />
                        </group>
                        <group>
                            <field name="creation_date" readonly="1"/>
                            <field name="sopf_sequence" readonly="1"/>
                            <field name="po_date" readonly="1"/>
                            <field name="po_number" readonly="1"/>
                            <field name="po_attach_ids" widget="many2many_binary" />
                        </group>
                    </group>
                    <separator/>
                    <group>
                        <field name="special_instructions" placeholder="Special Instructions...." attrs="{'readonly': [('state','in',['sale','done'])]}"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="attributes">
                <attribute name="attrs">{'readonly': ['&amp;', ('bypass_quote', '=', False), '|','|',('state', 'in', ('done','cancel')),('bci_stage', '=', 'approved'),('bci_quote_type','=',False)]}</attribute>
                <attribute name="options">{'no_create': [('bci_is_estimation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='tax_id']" position="after">
                <field name="bci_discount" />
                <field name="bci_price_with_discount" invisible="1"/>                
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                    <field name="bci_section"  />
                    <field name="bci_subsection"  />
                    <field name="bci_is_optional"  />
                    <field name="bci_pricing_factor" invisible="1" />
                    <field name="bci_discount_category" invisible="1"/>
                    <field name="bci_duty" invisible="1"/>
                    <field name="bci_freight" invisible="1" />
                    <field name="bci_exchange_rate" invisible="1"/>
                    <field name="bci_purchase_cost" invisible="1"/>
                    <field name="bci_purchase_currency" invisible="1" />
                    <field name="bci_discount" invisible="1" />
                    <field name="bci_landed_cost" invisible="1" />
                    <field name="bci_suggested_price_unit" invisible="1" />
                    <field name="bci_principal_cost" invisible="1"/>
                    <field name="bci_target_margin" invisible="1" />
                    <field name="sopf_done_quantity" invisible="1"/>
                    <field name="sopf_done_amount" invisible="1"/>
                    <field name="bci_principal_cost" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='bci_is_optional']" position="after">
                <button name="open_product_last_sale_popup" type="object" icon="fa-ellipsis-h" string=" "/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="inheried_view_quotation_tree_with_onboarding" >
        <field name="name">Sale order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="bci_version"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="sale_order_form_view_inherit_cost_estimation_bci">
        <field name="name">Sale Order Form View Inherit Cost Estimation BCI</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="cost_estimation.sale_order_form_view_inherit_cost_estimation"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='estimation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bci_sale_template_view_form" model="ir.ui.view">
        <field name="name">sale.order.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_order_date" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.order.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="replace">
                <field name="sopf_sequence" string="ERP SOPF Number"/>
                <field name="date_order" string="SOPF Date" widget="datetime"
                    options="{'format': 'DD/MM/YYYY HH:mm:ss'}" />
            </xpath>
            <xpath expr="//field[@name='name']" position="replace" />
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="name" string="Number" readonly="1" decoration-bf="1" />
            </xpath>
        </field>
    </record>
    <record id="view_order_form_hide_shipping_button" model="ir.ui.view">
        <field name="name">sale.order.form.hide.shipping.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="delivery.view_order_form_with_carrier"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_delivery_wizard'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>