<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_coverage_type" model="ir.actions.act_window">
        <field name="name">Coverage Type</field>
        <field name="res_model">barcode_india.coverage_type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
    </record>
    <record model="ir.ui.view" id="barcode_india_coverage_type_tree_view">
        <field name="name">Coverage Type</field>
        <field name="model">barcode_india.coverage_type</field>
        <field name="arch" type="xml">
            <tree string="Coverage Type" editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>
</odoo>