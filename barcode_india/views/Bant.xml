<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="barcode_india_bant_tree">
        <field name="name">Bant</field>
        <field name="model">barcode_india.bant</field>
        <field name="arch" type="xml">
            <list string="BANT" editable="bottom">
                <field name="name"/>
                <field name="weightage" widget="percentage"/>
            </list>
        </field>
    </record>
    <record id="action_barcode_india_bant" model="ir.actions.act_window">
        <field name="name">Bant</field>
        <field name="res_model">barcode_india.bant</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    BANT
                </p>
        </field>
    </record>
</odoo>