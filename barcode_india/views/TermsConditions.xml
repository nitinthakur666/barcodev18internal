<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_termsconditions" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="res_model">barcode_india.tnc</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Terms and Conditions
                </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_termsconditions_tree">
        <field name="name">Terms and Conditions</field>
        <field name="model">barcode_india.tnc</field>
        <field name="arch" type="xml">
            <list string="Terms and Conditions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bci_description"/>
                <field name="bci_quotation_type" widget='many2many_tags'/>
            </list>
        </field>
    </record>
</odoo>