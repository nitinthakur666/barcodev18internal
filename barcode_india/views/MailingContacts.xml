<odoo>
    <data>

        <record id="mailing_contact_view_form_barcode" model="ir.ui.view">
            <field name="name">mailing.contact.view.form.barcode</field>
            <field name="model">mailing.contact</field>
            <field name="inherit_id" ref="mass_mailing.mailing_contact_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='country_id']" position="after">
                    <field name="bci_survey_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>