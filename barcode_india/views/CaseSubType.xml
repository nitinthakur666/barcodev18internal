<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_case_sub_type" model="ir.actions.act_window">
        <field name="name">Case Sub Type</field>
        <field name="res_model">barcode_india.case_sub_type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Case Sub Type
                </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_case_sub_type_tree">
        <field name="name">Case Sub Type</field>
        <field name="model">barcode_india.case_sub_type</field>
        <field name="arch" type="xml">
            <list string="Case Sub Type" editable="bottom">
                <field name="name"/>
                <field name="bci_case_type"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="barcode_india_case_sub_type_search_view" model="ir.ui.view">
        <field name="name">barcode_india.case_sub_type.search.view</field>
        <field name="model">barcode_india.case_sub_type</field>
        <field name="arch" type="xml">
            <search string="Search Case Sub type">
                <field name="name" />
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>
</odoo>