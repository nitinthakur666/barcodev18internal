<odoo>
    <data>

        <record id="view_mail_mass_mailing_form_barcode" model="ir.ui.view">
            <field name="name">mailing.mailing.form.barcode</field>
            <field name="model">mailing.mailing</field>
            <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='settings']/group" position="inside">
                    <group string="Survey">
                        <label for="bci_survey_id"/>
                        <div class="o_row">
                            <field name="bci_survey_id"/>
                            <button name="action_update_survey" type="object" class="btn btn-primary fa fa-refresh" role="img" string="Update Survey on Recipients" title="Update Survey on Recipients" modifiers="{'invisible': [('bci_survey_id', '=', False)]}"/>
                        </div>
                    </group>
                  </xpath>
            </field>
        </record>

    </data>
</odoo>