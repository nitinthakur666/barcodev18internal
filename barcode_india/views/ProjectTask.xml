        <record id="fsm_task_tree_inherit_barcode" model="ir.ui.view">
            <field name="name">project.task.tree.barcode</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="industry_fsm.project_task_view_list_fsm" />
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="multi_edit">1</attribute>
                </xpath>
                <xpath expr="//field[@name='project_id']" position="before">
                    <field name="helpdesk_ticket_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_task_kanban_inherit_barcode" model="ir.ui.view">
            <field name="name">project.task.kanban.barcode</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_kanban"/>
            <field name="arch" type="xml">
                <kanban position="attributes">
                    <attribute name="default_order">date_deadline asc</attribute>
                </kanban>
            </field>
        </record>

        <record id="industry_fsm.project_task_action_fsm" model="ir.actions.act_window">
            <field name="context">{
                'fsm_mode': True,
                'search_default_my_tasks': True,
                'search_default_groupby_stage': True,
                'default_user_ids': [(4, uid)],
                'default_scale': 'day',
            }</field>
        </record>
    </data>
</odoo>
