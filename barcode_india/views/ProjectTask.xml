<odoo>
    <data>
        <record id="project_task_form_barcode" model="ir.ui.view">
            <field name="name">project.task.form.barcode</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="display_helpdesk_ticket_button" invisible="1" />
                    <button string="Ticket" class="oe_stat_button" name="action_view_ticket" type="object" icon="fa-life-ring" attrs="{'invisible': [('display_helpdesk_ticket_button', '=', False)]}" help="Ticket from this task"/>
                    <button class="oe_stat_button" name="action_view_tickets" icon="fa-life-ring" type="object" attrs="{'invisible': [('bci_bulk_import', '=', False)]}">
                        <field name="bci_ticket_count" string="Bulk Tickets" widget="statinfo" />
                    </button>
                    <button class="oe_stat_button" string="Assets" name="action_pm_status" icon="fa-certificate" type="object" attrs="{'invisible': [('bci_is_pm','=',False)]}"/>
                    <button class="oe_stat_button" type="object" name="action_show_related_quotations" icon="fa-pencil-square-o" attrs="{'invisible': [('bci_quotation_count', '=', 0)]}">
                        <field name="bci_quotation_count" widget="statinfo" string="Quotations"/>
                    </button>
                    <button name="action_show_bugs" string="Bugs" type="object" icon="fa-usd">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="bci_bug_task_count" widget="statinfo" nolabel="1"/></span>
                            <span class="o_stat_text">Bugs</span>
                        </div>
                    </button>
                    <button name="action_show_test_case" string="Test Cases" type="object" icon="fa-usd">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="bci_test_case_count" widget="statinfo" nolabel="1"/></span>
                            <span class="o_stat_text">Test Cases</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="bci_is_bug" invisible="1"/>
                    <field name="bci_reported_project" attrs="{'invisible': [('bci_is_bug', '!=', True)]}"  domain="[('partner_id', '=', partner_id)]"/>
                    <field name="bci_reported_task" attrs="{'invisible': [('bci_is_bug', '!=', True)]}" domain="[('project_id', '=', bci_reported_project)]"/>
                </xpath>
                <xpath expr="//field[@name='user_ids']" position="after">
                    <field name="bci_issue_resolved" attrs="{'invisible': [('hide_fields', '=', True)]}"/>
                    <field name="bci_bulk_import" attrs="{'invisible': [('hide_fields', '=', True)]}"/>
                    <field name="bci_asset_id" attrs="{'invisible': [('hide_fields', '=', True)]}"/>
                    <field name="bci_product_id" attrs="{'invisible': [('hide_fields', '=', True)]}"/>
                    <field name="bci_is_pm" invisible="1" attrs="{'invisible': [('hide_fields', '=', True)]}"/>
                    <field name="lead_id" attrs="{'invisible': [('hide_fields', '=', True)]}"/>
                    <field name="hide_fields" invisible="1"/>
                <!-- </xpath>
                <xpath expr="//field[@name='partner_phone']" position="after"> -->
                    <field name="bci_site_id" widget="res_partner_many2one" options="{'always_reload': True}" context="{'show_address': is_fsm, 'res_partner_search_mode': 'customer'}"/>
                    <field name="bci_address"/>
                    <field name="bci_site_phone" widget="phone" attrs="{'invisible': [('bci_site_id', '=', False)]}"/>
                </xpath>
                <xpath expr="//page[@name='description_page']" position="after">
                    <page string="Final Resolution" attrs="{'invisible': [('is_fsm','=',False)]}">
                        <field name="bci_final_resolution">
                            <tree editable="bottom">
                                <field name="name" type="html"/>
                                <field name="bci_task_id" invisible="1"/>
                                <field name="bci_ticket_id" invisible="1"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//div[@class='w-100']" position="replace">
                </xpath>
                <xpath expr="//label[@for='planned_date_begin']" position="replace">
                    <label for="planned_date_begin" string="Planned Date" />
                    <div class="w-100">
                        <div class="o_row">
                        <field name="planned_date_begin" widget="daterange" options="{'related_end_date': 'planned_date_end'}" attrs="{'required': [('planned_date_end', '!=', False)]}"/>
                        <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                        <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                        <field name="planned_date_end" widget="daterange" options="{'related_start_date': 'planned_date_begin'}" attrs="{'required': [('planned_date_begin', '!=', False)]}"/>
                    </div>
                    </div>
                </xpath>
                <xpath expr="//field[@name='project_id']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="before">
                    <label for="bci_actual_start_date" string="Actual Date" />
                    <div class="w-100" >
                        <div class="o_row">
                            <field name="bci_actual_start_date" widget="daterange" options="{'related_end_date': 'bci_actual_end_date'}" attrs="{'required': [('bci_actual_end_date', '!=', False)]}"/>
                            <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                            <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                            <field name="bci_actual_end_date" widget="daterange" options="{'related_start_date': 'bci_actual_start_date'}" attrs="{'required': [('bci_actual_start_date', '!=', False)]}"/>
                        </div>
                    </div>
                </xpath>

                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="context">{'search_view_ref' : 'project.view_task_search_form_extended','default_display_project_id': project_id if not parent_id or not display_project_id else display_project_id, 'default_project_id': project_id if not parent_id or not display_project_id else display_project_id, 'default_user_ids': user_ids, 'default_parent_id': id, 'default_partner_id': partner_id, 'default_milestone_id': allow_milestones and milestone_id, 'search_default_display_project_id': project_id }</attribute>
                </xpath>

                <xpath expr="//field[@name='child_ids']/tree/field[@name='activity_ids']" position="after">
                    <field name="planned_date_begin"/>
                    <field name="planned_date_end"/>
                </xpath>

            </field>
        </record>

