<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_tax_group" model="ir.actions.act_window">
        <field name="name">Tax Group</field>
        <field name="res_model">barcode_india.tax_group</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
    </record>
    <record model="ir.ui.view" id="barcode_india_tax_group_tree_view">
        <field name="name">Tax Group</field>
        <field name="model">barcode_india.tax_group</field>
        <field name="arch" type="xml">
            <tree string="Group Group" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
            </tree>
        </field>
    </record>
</odoo>