<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">barcode_india.contracts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Contracts
                </p>
        </field>
    </record>

    <record id="barcode_india_contract_form_view" model="ir.ui.view">
        <field name="name">Contracts</field>
        <field name="model">barcode_india.contracts</field>
        <field name="arch" type="xml">
            <form string="Contracts">
                <header>
                    <field name="bci_stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_assets" icon="fa-certificate" type="object" modifiers="{'invisible': [('bci_assets_count','=',0)]}">
                            <field name="bci_assets_count" string="Assets" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_sites" icon="fa-sitemap" type="object">
                            <field name="bci_site_count" string="Sites" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_tickets" icon="fa-life-ring" type="object" modifiers="{'invisible': [('bci_ticket_count', '=', 0)]}">
                            <field name="bci_ticket_count" string="Tickets" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="action_view_opportunities" icon="fa-star" type="object" modifiers="{'invisible': [('bci_opportunity_count', '=', 0)]}">
                            <field name="bci_opportunity_count" string="Opportunities" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="action_contract_details" icon="fa-star" type="object" modifiers="{'invisible': [('bci_contract_type_find','!=','Software')]}">
                            <field name="bci_contract_details_count" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" name="action_previous_assets" icon="fa-certificate" type="object" string="Previous Assets" modifiers="{'invisible': ['|','|',('bci_stage_type','!=','Expired'),('bci_contract_id','=',False),('bci_contract_type_find','!=','Hardware')]}">
                        </button>
                        <button class="oe_stat_button" name="action_draft_assets" icon="fa-certificate" type="object" string="Draft Assets" modifiers="{'invisible': ['|',('bci_renewal_status','!=','To Be Activated'),('bci_contract_type_find','!=','Hardware')]}">
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" modifiers="{'invisible': [('active', '=', True)]}"/>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="bci_customer" required="1"/>
                            <field name="bci_start" readonly="0"/>
                            <field name="bci_end" readonly="0"/>
                            <field name="bci_type"/>
                            <field name="bci_address_verification"/>
                            <field name="bci_preferred_applicable"/>
                            <field name="bci_pm"/>
                            <field name="bci_pm_frequency" modifiers="{'invisible':[('bci_pm','=',False)]}"/>
                            <field name="bci_amc_required" invisible="1"/>
                            <field name="bci_renewal_status"/>
                            <field name="bci_renewal_opportunity" />
                            <field name="bci_service_product" modifiers="{'invisible': [('bci_contract_type_find','!=','Software')]}"/>
                            <field name="bci_opportunity" invisible="1"/>
                            <field name="bci_contract_type_find" invisible="1"/>
                            <field name="bci_stage_type" invisible="1"/>
                            <field name="bci_contract_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="bci_saleperson"/>
                            <field name="bci_team_id" />
                            <field name="bci_origin"/>
                            <field name="bci_invoice_date"/>
                            <field name="bci_invoice_number"/>
                            <field name="bci_order_ref"/>
                            <field name="bci_sopf_number"/>
                            <field name="bci_invoice_internal_id"/>
                            <!-- <field name="bci_site" domain="[('type','=','site'),('parent_id','=',bci_customer)]"/> -->
                            <field name="bci_site" domain="[('bci_contact_type','=','Site'),('bci_parent_company','=',bci_customer)]"/>
                            <label for="bci_street" string="Address"/>
                            <div class="o_address_format">
                                <field name="bci_street" class="o_address_street" placeholder="Street..."/>
                                <field name="bci_street2" class="o_address_street" placeholder="Street 2..."/>
                                <field name="bci_street3" class="o_address_street" placeholder="Street 3..."/>
                                <field name="bci_street4" class="o_address_street" placeholder="Street 4..."/>
                                <field name="bci_city" class="o_address_city" placeholder="City"/>
                                <field name="bci_state_id" class="o_address_state" placeholder="State"/>
                                <field name="bci_zip" class="o_address_zip" placeholder="ZIP"/>
                                <field name="bci_country_id" class="o_address_country" placeholder="Country"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entitlememnt">
                            <group>
                                <group>
                                    <field name="bci_local_visit"/>
                                </group>
                                <group>
                                    <field name="bci_outstation_visit"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="barcode_india_contract_tree">
        <field name="name">Contracts</field>
        <field name="model">barcode_india.contracts</field>
        <field name="arch" type="xml">
                <list string="Contracts">
                    <field name="create_date"/>
                    <field name="name"/>
                    <field name="bci_sopf_number"/>
                    <field name="bci_invoice_number"/>
                    <field name="bci_customer"/>
                    <field name="bci_start"/>
                    <field name="bci_end"/>
                    <field name="bci_saleperson"/>
                    <field name="bci_team_id"/>
                </list>
        </field>
    </record>
</odoo>