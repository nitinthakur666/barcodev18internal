<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_status" model="ir.actions.act_window">
        <field name="name">Status</field>
        <field name="res_model">barcode_india.status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
    </record>
    <record model="ir.ui.view" id="barcode_india_status_tree_view">
        <field name="name">Status</field>
        <field name="model">barcode_india.status</field>
        <field name="arch" type="xml">
            <list string="Status" editable="bottom">
                <field name="name" />
                <field name="probability"/>
            </list>
        </field>
    </record>
</odoo>