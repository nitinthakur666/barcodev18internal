<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quotation_type_tree" model="ir.ui.view">
        <field name="name">Quotation Type</field>
        <field name="model">barcode_india.quotation_type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name"/>
                <field name="auto_approval" />
                <field name="estimation" />
            </list>
        </field>
    </record>

    <record id="quotation_type_form" model="ir.ui.view">
        <field name="name">Quotation Type Form</field>
        <field name="model">barcode_india.quotation_type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" required="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="sequence" invisible="1"/>
                            <field name="auto_approval" />
                            <field name="erp_category" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="estimation" />
                            <field name="bci_bypass_quote" />
                        </group>
                    </group>
                    <group>
                        <field name="apply_quotetype_limit" />
                    </group>
                    <group >
                        <group>
                            <field name="quote_limit" modifiers="{'invisible':[('apply_quotetype_limit', '=', False)],'required':[('apply_quotetype_limit', '!=', False)]}"/>
                        </group>
                        <group>
                            <field name="quotetype_after_limit" modifiers="{'invisible':[('apply_quotetype_limit', '=', False)],'required':[('apply_quotetype_limit', '!=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Term Approval Matrix" name="bci_pt_approval_matrix">
                            <field name="pt_margin_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="customer_type"/>
                                    <field name="customer_category" />
                                    <field name="value" />
                                    <field name="approving_authority" />
                                    <field name="quotations_type_id" invisible="1"/>

                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="sequence" widget="handle" invisible="1" />
                                                <field name="customer_type" required="1"/>
                                                <field name="customer_category" required="1"/>
                                                <field name="approving_authority" required="1"/>
                                                <field name="approvers" widget="many2many_tags" modifiers="{'invisible': [('approving_authority', '!=', 'user')]}"/>
                                            </group>
                                            <group>
                                                <field name="value" />
                                                <field name="quotations_type_id" invisible="1"/>
                                                <field name="recommending_authority" required="1"/>
                                                <field name="recommending_approvers" widget="many2many_tags" modifiers="{'invisible': [('recommending_authority', '!=', 'user')]}"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Margin Approval Matrix" name="bci_approval_matrix">
                            <field name="margin_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="deal_margin"/>
                                    <field name="approver_type" required="1"/>
                                    <field name="approver" widget="many2many_tags" modifiers="{'invisible': [('approver_type', '!=', 'user')]}"/>
                                    <field name="quotation_type_id" invisible="1"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="deal_margin"/>
                                            <field name="sequence" widget="handle" invisible="1"/>
                                            <field name="approver_type" required="1"/>
                                            <field name="approver" widget="many2many_tags" modifiers="{'invisible': [('approver_type', '!=', 'user')]}"/>
                                            <field name="quotation_type_id" invisible="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Payment Milestones" name="payment_term_ids">
                            <field name="payment_terms_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="bci_percentage" />
                                </list>
                            </field>
                        </page>
                        <page name="special_approval" string="Special Approval">
                            <group>
                                <group>
                                    <field name="special_approval" />
                                    <field name="bg_pbg_approval" />
                                    <field name="ld_clause_approval" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids" widget="mail_thread" nolabel="1"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_quotation_type" model="ir.actions.act_window">
        <field name="name">Quotation Type</field>
        <field name="res_model">barcode_india.quotation_type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>