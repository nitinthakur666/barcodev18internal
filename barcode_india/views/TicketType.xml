<odoo>
    <data>

        <record id="helpdesk_ticket_type_action" model="ir.actions.act_window">
			<field name="name">Types</field>
			<field name="res_model">helpdesk.ticket.type</field>
			<field name="view_mode">list,form</field>
			<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No types found. Let's create one!
			</p><p>
				Types are perfect for categorizing your tickets.
			</p>
			</field>
		</record>

		<menuitem id="helpdesk_ticket_type_menu" action="helpdesk_ticket_type_action"
        sequence="10" parent="helpdesk.helpdesk_menu_config"/>

        <record id="helpdesk_ticket_type_view_form" model="ir.ui.view">
            <field name="name">helpdesk.ticket.type.form</field>
            <field name="model">helpdesk.ticket.type</field>
            <field name="arch" type="xml">
                <form string="Problem Sub Type">
                    <group>
                        <field name="sequence" invisible="1"/>
                        <field name="name"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="helpdesk_ticket_type_list_view_barcode" model="ir.ui.view">
	        <field name="name">helpdesk.ticket.type.list.barcode</field>
	        <field name="model">helpdesk.ticket.type</field>
	        <field name="arch" type="xml">
                <list editable="bottom" string="Problem Sub Type">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" column_invisible="True"/>
                    <field name="bci_problem_type"/>
                </list>
	        </field>
	    </record>

        <record id="barcode_india_problem_type_search_view" model="ir.ui.view">
            <field name="name">helpdesk.ticket.type.search.view</field>
            <field name="model">helpdesk.ticket.type</field>
            <field name="arch" type="xml">
                <search string="Search Problem Sub Type">
                    <field name="name" />
                    <separator/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                </search>
            </field>
        </record>
    </data>
</odoo>