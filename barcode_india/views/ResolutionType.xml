<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_resolution_type" model="ir.actions.act_window">
        <field name="name">Resolution Type</field>
        <field name="res_model">barcode_india.resolution_type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Resolution Type
                </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_resolution_type_tree">
        <field name="name">Resolution Type</field>
        <field name="model">barcode_india.resolution_type</field>
        <field name="arch" type="xml">
            <list string="Resolution Type" editable="bottom">
                <field name="name"/>
                <field name="active" invisible="1"/>

            </list>
        </field>
    </record>
    
     <record id="barcode_india_resolution_type_search_view" model="ir.ui.view">
        <field name="name">barcode_india.resolution_type.search.view</field>
        <field name="model">barcode_india.resolution_type</field>
        <field name="arch" type="xml">
            <search string="Search Problem type">
                <field name="name" />
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>
</odoo>