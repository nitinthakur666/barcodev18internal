<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bci_pm_tree_view" model="ir.ui.view">
        <field name="name">PM Tree View</field>
        <field name="model">barcode_india.pm_status</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="product_id"/>
                <field name="status"/>
                <field name="comments"/>
                <field name="task_id" invisible="1"/>
                <button string="Create Ticket" class="oe_stat_button" name="action_create_ticket" type="object" help="Ticket from this task" modifiers="{'invisible': ['|',('ticket_id','!=',False),('status','!=','PM Complete - Issue Found')]}"/>
                <field name="ticket_id" readonly="1"/>
            </list>
        </field>
    </record>
</odoo>