<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_terms_code" model="ir.actions.act_window">
        <field name="name">Terms Code</field>
        <field name="res_model">barcode_india.terms_code</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
    </record>
    <record model="ir.ui.view" id="barcode_india_terms_code_tree_view">
        <field name="name">Terms Code</field>
        <field name="model">barcode_india.terms_code</field>
        <field name="arch" type="xml">
            <list string="Group Group" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
            </list>
        </field>
    </record>
</odoo>