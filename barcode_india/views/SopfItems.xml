<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sopf_items_tree" model="ir.ui.view">
        <field name="name">sopf.items.tree</field>
        <field name="model">barcode_india.sopf_items</field>
        <field name="arch" type="xml">
            <list string="Legacy SOPF Items" create="false" edit="false" delete="false">
                <field name="sopf_id"/>
                <field name="part_number"/>
                <field name="item_description"/>
                <field name="quantity"/>
                <field name="order_price"/>
                <field name="amount_after_tax"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- SOPF Items Search View -->
    <record id="view_sopf_items_search" model="ir.ui.view">
        <field name="name">sopf.items.search</field>
        <field name="model">barcode_india.sopf_items</field>
        <field name="arch" type="xml">
            <search>
                <filter name="sopfitems_status_posted" string="Posted" domain="[('sopf_id.sopf_status','=','Posted')]"/>
            </search>
        </field>
    </record>    

    <!-- SOPF Items Form View -->
    <record id="view_sopf_items_form" model="ir.ui.view">
        <field name="name">sopf.items.form</field>
        <field name="model">barcode_india.sopf_items</field>
        <field name="arch" type="xml">
            <form string="SOPF Item" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="sopf_id"/>
                            <field name="sopf_number_text"/>
                            <field name="part_number"/>
                            <field name="item_description"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="tax_applicable"/>
                            <field name="amount_after_tax"/>
                        </group>
                        <group>
                            <field name="pricing_category"/>
                            <field name="approved_quote_price"/>
                            <field name="discount_applied"/>
                            <field name="total_order_amount"/>
                            <field name="order_price"/>
                            <field name="model_number"/>
                            <field name="warranty"/>
                            <field name="hsn_code"/>
                            <field name="gst_tax_rate"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sopf_items" model="ir.actions.act_window">
        <field name="name">Legacy SOPF Items</field>
        <field name="res_model">barcode_india.sopf_items</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_sopfitems_status_posted' : 1}</field>
    </record>
</odoo>
