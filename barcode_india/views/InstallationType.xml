<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="barcode_india_installation_type">
        <field name="name">Installation Type</field>
        <field name="model">barcode_india.installation_types</field>
        <field name="arch" type="xml">
            <list string="Installation Type" editable="bottom">
                <field name="name"/>
                <field name="minimum_charge" />
                <field name="percentage_of_Hardware" />
            </list>
        </field>
    </record>
    <record id="action_barcode_india_installation_type" model="ir.actions.act_window">
        <field name="name">Installation Type</field>
        <field name="res_model">barcode_india.installation_types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="domain"></field>
    </record>
</odoo>