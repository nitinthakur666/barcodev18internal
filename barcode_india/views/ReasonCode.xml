<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_reason_code" model="ir.actions.act_window">
        <field name="name">RCA Reason Code</field>
        <field name="res_model">barcode_india.reason_code</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    RCA Reason Code
                </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_reason_code_tree">
        <field name="name">RCA Reason Code</field>
        <field name="model">barcode_india.reason_code</field>
        <field name="arch" type="xml">
            <list string="RCA Reason Code" editable="bottom">
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
     <record id="barcode_india_rca_reason_code_search_view" model="ir.ui.view">
        <field name="name">barcode_india.reason_code.search.view</field>
        <field name="model">barcode_india.reason_code</field>
        <field name="arch" type="xml">
            <search string="Search Problem type">
                <field name="name" />
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>
</odoo>