<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.barcode_india</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="55"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="BCIL" string="BCIL" name="barcode_india">
                    <h2>Integrations</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <!-- <div class="o_setting_left_pane">
                                <field name="module_sage"/>
                            </div> -->
                            <div class="o_setting_right_pane">
                                <!-- <label for="module_sage"/> -->
                                <div class="text-muted">
                                    Sync data with <i>'Sage CRM'</i>
                                </div>
                                <div class="content-group">
                                    <div>
                                        <div class="col-12 col-lg-6 o_setting_box">
                                            <div>
                                                <label for="bci_username"/>
                                                <field name="bci_username" password="True"/>
                                            </div>
                                            <div>
                                                <label for="bci_password"/>
                                                <field name="bci_password" password="True"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="content-group">
                                        <div>
                                            <group>
                                                <label for="bci_base_url" string="Base URL"/>
                                                <field name="bci_base_url" colspan="5" nolabel="1"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Threshold</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="o_setting_right_pane">
                            <div class="row">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="row mt16">
                                        <label for="bci_exchange_threshold" class="col-lg-4 o_light_label"/>
                                        <field name="bci_exchange_threshold" colspan="5"/>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="row mt16">
                                        <label for="bci_cost_threshold" class="col-lg-4 o_light_label"/>
                                        <field name="bci_cost_threshold" colspan="5"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>sales</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="o_setting_right_pane">
                            <div class="row">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <!-- <div class="row mt16">
                                        <label for="bci_hardware_project" class="col-lg-4 o_light_label"/>
                                        <field name="bci_hardware_project" colspan="5"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="bci_hardware_user" class="col-lg-4 o_light_label"/>
                                        <field name="bci_hardware_user" colspan="5"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="bci_hardware_tags" class="col-lg-4 o_light_label"/>
                                        <field name="bci_hardware_tags" widget="many2many_tags" colspan="5"/>
                                    </div> -->
                                    <div class="row mt16">
                                        <label for="bci_freight_product" class="col-lg-4 o_light_label"/>
                                        <field name="bci_freight_product" colspan="5"/>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <!-- <div class="row mt16">
                                        <label for="bci_software_project" class="col-lg-4 o_light_label"/>
                                        <field name="bci_software_project" colspan="5"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="bci_software_user" class="col-lg-4 o_light_label"/>
                                        <field name="bci_software_user" colspan="5"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="bci_software_tags" class="col-lg-4 o_light_label"/>
                                        <field name="bci_software_tags" widget="many2many_tags" colspan="5"/>
                                    </div> -->
                                    <div class="row mt16">
                                        <label for="bci_installation_product" class="col-lg-4 o_light_label"/>
                                        <field name="bci_installation_product" colspan="5"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Product</h2>
                    <div class="row mt16 o_settings_container" name="request_vendor_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="bci_use_latest_price" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="bci_use_latest_price"/>
                                <div class="text-muted">
                                    This option allows you to use the latest vendor price when creating sale orders.
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Vendor Location</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="o_setting_right_pane">
                            <div class="row">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="row mt16">
                                        <label for="bci_location" class="col-lg-4 o_light_label"/>
                                        <field name="bci_location" colspan="5"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_barcode_india_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'barcode_india'}</field>
    </record>
</odoo>
