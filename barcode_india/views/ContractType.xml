<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_contract_type" model="ir.actions.act_window">
        <field name="name">Contracts Type</field>
        <field name="res_model">barcode_india.contracts.type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree</field>
        <field name="domain"></field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Contracts Type
                </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_contract_type_tree">
        <field name="name">Contracts Type</field>
        <field name="model">barcode_india.contracts.type</field>
        <field name="arch" type="xml">
            <tree string="Contracts Type" editable="bottom">
                <field name="name"/>
                <field name="type"/>
            </tree>
        </field>
    </record>
</odoo>