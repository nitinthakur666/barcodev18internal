<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_barcode_india_discount_category" model="ir.actions.act_window">
        <field name="name">Discount Category</field>
        <field name="res_model">barcode_india.discount_category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Discount Category Master
            </p>
        </field>
    </record>
    <record model="ir.ui.view" id="barcode_india_discount_category_tree_view">
        <field name="name">Discount Category Master Tree View</field>
        <field name="model">barcode_india.discount_category</field>
        <field name="arch" type="xml">
            <list string="Discount Category Master" editable="bottom">
                <field name="name" />
                <field name="bci_discount" />
                <field name="is_promocode" />
            </list>
        </field>
    </record>
</odoo>