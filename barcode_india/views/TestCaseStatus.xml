<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree view -->
        <record id="barcode_india_test_case_status_tree_view" model="ir.ui.view">
            <field name="name">Barcode India Test Case Status Tree View</field>
            <field name="model">barcode_india.test_case_status</field>
            <field name="arch" type="xml">
                <list string="Test Case Status" editable="bottom">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="action_barcode_india_test_case_status" model="ir.actions.act_window">
            <field name="name">Test Case Status</field>
            <field name="res_model">barcode_india.test_case_status</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list</field>
            <field name="domain"></field>
        </record>
    </data>  
</odoo>