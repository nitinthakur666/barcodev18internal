<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree view -->
        <record id="barcode_india_test_cases_tree_view" model="ir.ui.view">
            <field name="name">Barcode India Test Case Tree View</field>
            <field name="model">barcode_india.test_cases</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="test_status"/>
                    <field name="task_id"/>
                    <field name="project_id"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="barcode_india_test_cases_form_view" model="ir.ui.view">
            <field name="name">Barcode India Test Case Form View</field>
            <field name="model">barcode_india.test_cases</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="test_status"/>
                            <field name="task_id"/>
                            <field name="project_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Graph view -->
        <record id="barcode_india_test_cases_graph_view" model="ir.ui.view">
            <field name="name">Barcode India Test Case Graph View</field>
            <field name="model">barcode_india.test_cases</field>
            <field name="arch" type="xml">
                <graph>
                    <field name="test_status"/>
                    <field name="project_id"/>
                </graph>
            </field>
        </record>

        <!-- Pivot view -->
        <record id="barcode_india_test_cases_pivot_view" model="ir.ui.view">
            <field name="name">Barcode India Test Case Pivot View</field>
            <field name="model">barcode_india.test_cases</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="name" type="row"/>
                    <field name="project_id" type="row"/>
                    <field name="task_id" type="row"/>
                    <field name="test_status" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- Action -->
        <record id="action_barcode_india_test_cases" model="ir.actions.act_window">
            <field name="name">Test Cases</field>
            <field name="res_model">barcode_india.test_cases</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form,graph,pivot</field>
        </record>

    </data>
</odoo>