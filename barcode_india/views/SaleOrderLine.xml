<odoo>
    <data>
        
        <record id="barcode_india_order_line_tree_view_second" model="ir.ui.view">
            <field name="name">Barcode India Order Line Tree View Second</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <tree string="Sales Order Lines" expand="1" editable="bottom">
                    <field name="product_id" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}" />
                    <field name="company_id" invisible="1"/>
                    <field name="bci_part_number" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}" />
                    <field name="bci_model_number" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}" />
                    <field name="product_uom_qty" string="Qty" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}" />
                    <field name="name" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}" />
                    <field name="bci_suggested_price_unit" force_save="1" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False),('is_line_pricing_provider','=',False)]}" />
                    <field name="bci_discount" attrs="{'readonly':['|',('is_line_approver','=',False),('bci_approval_stage','!=','pending'),('is_sales_person','=',False)]}" />                    
                    <field name="bci_target_margin" readonly="1" invisible="1"/>
                    <field name="bci_approved_margin" readonly="1" force_save="1" />
                    <field name="price_unit" force_save="1" attrs="{'readonly':['|','|',('bci_suggested_price_unit','=',0.00),('bci_approval_stage','!=','pending'),('is_line_approver','=',False),('is_sales_person','=',False)]}" />                    
                    <field name="bci_pricing_factor" invisible="1"/>
                    <field name="bci_discount_category" invisible="1"/>
                    <field name="bci_landed_cost" readonly="1" force_save="1"/>
                    <field name="bci_duty" invisible="1"/>
                    <field name="bci_freight" invisible="1"/>
                    <field name="bci_exchange_rate" force_save="1" readonly="1" />
                    <field name="bci_purchase_cost" force_save="1" readonly="1" invisible="1"/>
                    <field name="bci_principal_cost" readonly="1"/>
                    <field name="bci_pricing_category" readonly="1"/>
                    <field name="bci_approval_stage" force_save="1" readonly="1"/>
                    <field name="bci_approver" />
                    <field name="bci_pricing_provider"  widget="many2many_tags"/>
                    <field name="is_line_pricing_provider" invisible="1"/>
                    <field name="is_line_approver" invisible="1" />
                    <field name="is_sales_person" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" attrs="{'invisible':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}"/>
                </tree>
            </field>
        </record>

        
        <record id="barcode_india_pricing_provider_tree_view" model="ir.ui.view">
            <field name="name">Pricing Provider Tree View</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <tree string="Sales Order Lines" expand="1" editable="bottom" default_order="create_date desc, id desc">
                    <field name="order_partner_id" />
                    <field name="product_id" readonly="1"/>
                    <field name="company_id" invisible="1" readonly="1"/>
                    <field name="bci_part_number" readonly="1" />
                    <field name="bci_model_number" readonly="1"/>
                    <field name="product_uom_qty" string="Qty" readonly="1"/>
                    <field name="name" readonly="1"/>
                    <field name="currency_id" invisible="1" />
                    <field name="bci_pricing_category" readonly="1"/>
                    <field name="bci_approver" />
                    <field name="bci_pricing_provider"  widget="many2many_tags"/>
                    <field name="bci_suggested_price_unit" force_save="1" attrs="{'readonly':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False),('is_line_pricing_provider','=',False)]}" />
                    <field name="price_unit" readonly="1" force_save="1"/>
                    <field name="bci_pricing_factor" invisible="1"/>
                    <field name="bci_discount_category" invisible="1"/>
                    <field name="bci_discount" attrs="{'readonly':['|',('is_line_approver','=',False),('bci_approval_stage','!=','pending'),('is_sales_person','=',False)]}" />
                    <field name="bci_landed_cost" invisible="1" force_save="1"/>
                    <field name="bci_duty" invisible="1"/>
                    <field name="bci_freight" invisible="1"/>
                    <field name="bci_exchange_rate" readonly="1" />
                    <field name="bci_purchase_cost" readonly="1" force_save="1"/>
                    <field name="bci_applied_discount" readonly="1"/>
                    <field name="bci_freight" readonly="1" />
                    <field name="bci_duty" readonly="1" />
                    <field name="bci_target_margin" readonly="1" />
                    <field name="bci_warranty" optional="hide" readonly="1"/>
                    <field name="price_tax" optional="hide" readonly="1"/>
                    <field name="salesman_id" optional="hide" readonly="1"/>
                    <field name="bci_approval_stage" readonly="1" optional="hide"/>
                    <field name="bci_approved_margin" readonly="1" force_save="1" />
                    <field name="is_line_pricing_provider" invisible="1"/>
                    <field name="price_tax" optional="hide" readonly="1"/>
                    <field name="is_line_approver" invisible="1" />
                    <field name="is_sales_person" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" attrs="{'invisible':['|',('bci_approval_stage','!=','pending'),('is_line_approver','=',False)]}"/>
                </tree>
            </field>
        </record>

        <record id="sale_order_line_report_action" model="ir.actions.act_window">
            <field name="name">Sales Order Lines</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="barcode_india.barcode_india_pricing_provider_tree_view"/>
            <field name="domain">[("bci_approval_stage", "=", "pending"),("order_id.state", "!=", "cancel")]</field>
            <field name="context">{
                'search_default_group_by_date': 1,
                'search_default_group_by_order': 2
            }</field>
        </record>

        <record id="sale_order_line_search_baarcode" model="ir.ui.view">
            <field name="name">sale.order.line.search.barcode</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='salesman_id']" position="after">
                    <group expand="1" string="Group By">
                        <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                        <filter string="Sales Order" name="group_by_order" context="{'group_by': 'order_id'}"/>
                        <filter string="Pricing Category" name="bci_pricing_category" domain="[]" context="{'group_by':'bci_pricing_category'}"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>