<odoo>
	<data noupdate="1">
		<record id="sequence_company_code" model="ir.sequence">
            <field name="name">Company Code</field>
            <field name="code">barcode_india.company_code</field>
            <!-- <field name="prefix">CC</field> -->
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_national_account_code" model="ir.sequence">
            <field name="name">National Account Code</field>
            <field name="code">barcode_india.national_account_code</field>
            <field name="prefix">NA</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_contract_sequence" model="ir.sequence">
            <field name="name">Contract Sequence</field>
            <field name="code">barcode_india.contracts_seq</field>
            <field name="prefix">BCIL-%(year)s-%(month)s-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_create_sopf" model="ir.sequence">
            <field name="name">SOPF Sequence</field>
            <field name="code">bci.create_sopf</field>
            <field name="prefix">BCI/SF/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">no_gap</field>
            <field name="use_date_range">True</field>
        </record>
    
    </data>
</odoo>