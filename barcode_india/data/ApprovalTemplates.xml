<odoo>
    <data>
        <record id="bci_pricing_category_template" model="mail.template">
            <field name="name">Category Head Approval</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field name="subject">Pricing Category Notification</field>
            <field name="email_to">{{object.user_id.partner_id.email }}</field>
<!--            change from bci_approver to user_id.partner_id-->
            <field name="body_html" type="html">
                <div>
                    <div>
                        <p> Dear Ma'am/Sir,<br /> You have been assigned a new quotation <t t-out="object.name"></t> for pricing. Please Go to Sales>Pricing Requests> to fill in the price and approve the Order Line. </p>
                    </div>
                </div>
            </field>
        </record>

        <record id="bci_approval_template" model="mail.template">
            <field name="name">Approval</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field name="subject">Approval Notification</field>
            <field name="email_to">{{object.user_id.partner_id.email}}</field>
<!--            fill the blank to user_id.partner_id-->
            <field name="body_html" type="html">
                <div>
                    <p>Dear Ma'am/Sir,<br /> Products from your Vertical have been added to a quote: <t t-out="object.name" /> and sent for approval. </p>
                </div>
            </field>
        </record>
    </data>
</odoo>