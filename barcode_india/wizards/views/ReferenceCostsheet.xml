<odoo>
    <record id="view_bci_reference_costsheet_wizard_form" model="ir.ui.view">
        <field name="name">bci.reference_costsheet.wizard.form</field>
        <field name="model">bci.reference_costsheet</field>
        <field name="arch" type="xml">
            <form string="Select Reference Costsheet">
                <group>
                    <field name="current_sale_order_id" invisible="1" />
                    <field name="user_id" invisible="1" />
                    <field name="reference_sale_order_ids" invisible="1" />
                    <group string="Reference Quotations">
                        <field name="selected_sale_order_id" domain="[('id', 'in', reference_sale_order_ids)]" />
                    </group>
                    <notebook>
                        <page string="Order">
                            <field name="reference_order_line_ids">
                                <list editable="bottom" create="0">
                                    <field name="select_product"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="special_price" />
                                    <field name="special_price_locked" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="reference_costsheet_wizard"
                            string="Apply"
                            type="object"
                            class="btn-primary" />
                        <button string="Cancel"
                            class="btn-secondary"
                            special="cancel" />
                    </footer>
                </group>
            </form>
        </field>
    </record>
    
    <record id="view_bci_reference_costsheet_confirmation_form" model="ir.ui.view">
        <field name="name">bci.reference_costsheet.confirmation.form</field>
        <field name="model">bci.reference_costsheet.confirmation</field>
        <field name="arch" type="xml">
            <form string="Confirm Application">
                <span>Are you sure you want to apply the selected reference costsheet? This will overwrite existing order lines.</span>
                <footer>
                    <button name="confirm_action" string="Confirm" type="object" class="btn-primary"/>
                    <button name="cancel_action" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>