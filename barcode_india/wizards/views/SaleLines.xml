<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bci_sale_lines_form" model="ir.ui.view">
        <field name="name">sale lines</field>
        <field name="model">bci.sale_line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="bci_product" readonly="1"/>
                        <field name="bci_sale_price" readonly="1"/>
                        <field name="bci_sale_date" readonly="1"/>
                        <field name="bci_sale_order" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button string="OK" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>