<odoo>
    <record id="view_reference_costsheet_wizard_form" model="ir.ui.view">
        <field name="name">reference.costsheet.wizard.form</field>
        <field name="model">reference.costsheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Reference Costsheet">
                    <p>Are you sure you want to set the reference costsheet?</p>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reference_costsheet_wizard" model="ir.actions.act_window">
        <field name="name">Set Reference Costsheet</field>
        <field name="res_model">reference.costsheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_reference_costsheet_wizard_form"/>
    </record>

    <record id="view_unset_reference_costsheet_wizard_form" model="ir.ui.view">
        <field name="name">unset.reference.costsheet.wizard.form</field>
        <field name="model">unset.reference.costsheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Unset Reference Costsheet">
                    <p>Are you sure you want to unset the reference costsheet?</p>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_unset_reference_costsheet_wizard" model="ir.actions.act_window">
        <field name="name">Unset Reference Costsheet</field>
        <field name="res_model">unset.reference.costsheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_unset_reference_costsheet_wizard_form"/>
    </record>
</odoo>