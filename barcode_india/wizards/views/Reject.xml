<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reject_wizard_form" model="ir.ui.view">
        <field name="name">reject.wizard.form</field>
        <field name="model">reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Order Line">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="reason" placeholder="Enter reason for rejection..."/>
                </group>
                <footer>
                    <button name="confirm_reject" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Order Line</field>
        <field name="res_model">reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_reject_wizard_form"/>
    </record>
</odoo>