<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="barcode_india_approve_payment_term_view_form" model="ir.ui.view">
            <field name="name">Approve Payment Term Form View</field>
            <field name="model">barcode_india.approve_pay_term</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="approve_note" />
                        </group>
                    </sheet>
                    <footer>
                        <button string="Confirm" class="btn btn-primary"
                            name="action_approve_payment_term" type="object" />
                        <button string="Discard" class="btn btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>