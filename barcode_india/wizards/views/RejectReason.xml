<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reject_reason_for_bci" model="ir.ui.view">
        <field name="name">Reject Reason</field>
        <field name="model">barcode_india.reject_reason_wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="bci_crm_id" invisible="1"/>
                        <field name="bci_reject_reason"/>
                        <field name="bci_rejection_remark"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
