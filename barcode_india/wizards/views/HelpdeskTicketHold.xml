<odoo>
    <record id="view_helpdesk_ticket_hold_form_123" model="ir.ui.view">
        <field name="name">helpdesk.wizard.hold.form</field>
        <field name="model">helpdesk.wizard.hold</field>
        <field name="arch" type="xml">
            <form string="Put Ticket On Hold">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Submit" type="object" name="action_hold_ticket" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_cancel_form" model="ir.ui.view">
        <field name="name">helpdesk.wizard.cancel.form</field>
        <field name="model">helpdesk.wizard.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancel Ticket">
                <group>
                    <field name="cancel_reason"/>
                </group>
                <footer>
                    <button string="Submit" type="object" name="action_cancel_ticket" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>
