<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bci_rma_transfer_form" model="ir.ui.view">
        <field name="name">BCI Transfer</field>
        <field name="model">bci.rma.transfer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="bci_asset" required="1"/>
                        <field name="bci_pickup_type_id" required="1" domain="[('bci_spare_transfer','=',bci_spare_transfer)]"/>
                        <field name="bci_spare_transfer" invisible="1"/>
                        <field name="bci_receive_at_bci" invisible="1"/>
                        <field name="bci_receive_at_engineer" invisible="1"/>
                        <field name="bci_receive_at_defective" invisible="1"/>
                        <field name="bci_oem_involved" invisible="1"/>
                        <field name="bci_ticket_id" required="1" invisible="1"/>
                        <field name="bci_partner_id" required="1" invisible="1"/>
                    </group>
                    <group>
                        <field name="bci_oem_location_id" domain="[('usage','=','supplier')]" invisible="not bci_oem_involved" required="bci_oem_involved"/>
                        <field name="bci_oem" invisible="not bci_oem_involved" required="bci_oem_involved"/>
                        <field name="bci_location_id" domain="[('usage','=','internal'),('bci_engineer_location','=',False),('bci_defective_location','=',False)]" invisible="not bci_receive_at_bci" required="bci_receive_at_bci"/>
                        <field name="bci_engineer_location"  domain="[('usage','=','internal'),('bci_engineer_location','=',True),('bci_defective_location','=',False)]" invisible="not bci_receive_at_engineer" required="bci_receive_at_engineer"/>
                        <field name="bci_defective_location"  domain="[('usage','=','internal'),('bci_defective_location','=',True)]" invisible="not bci_receive_at_defective" required="bci_receive_at_defective"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
