<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cost_estimation_quotation_cost_form_view" model="ir.ui.view">
        <field name="name">Quotation Cost Form View</field>
        <field name="model">cost_estimation.quotation_cost</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" domain="[('software','=',True)]"/>
                            <field name="project_cost" widget="many2many_tags" />
                            <field name="product_uom_qty" />
                            <field name="price_unit" />
                            <field name="project_costs" widget="many2many_tags" invisible="1" />
                            <field name="cost_estimation" invisible="1" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="cost_estimation_quotation_cost_tree_view" model="ir.ui.view">
        <field name="name">Quotation Cost Tree View</field>
        <field name="model">cost_estimation.quotation_cost</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="product_id" options="{'no_create': True, 'no_open': True}" optional="show" domain="[('software','=',True)]"/>
                <field name="project_cost" options="{'no_create': True, 'no_open': True}" widget="many2many_tags" optional="show" />
                <field name="name" />
                <field name="product_uom_qty" optional="show" />
                <field name="price_unit" optional="show" />
                <field name="project_costs" widget="many2many_tags" invisible="1" />
                <field name="cost_estimation" invisible="1" />
            </list>
        </field>
    </record>
</odoo>