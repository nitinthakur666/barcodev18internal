<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cost_estimation_costing_form_view" model="ir.ui.view">
        <field name="name">Costing Form View</field>
        <field name="model">cost_estimation.costing</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="phase" options="{'no_open': True}" />
                        </h1>
                    </div>
                    <group>
                        <group string="Calculation">
                            <field name="activity_estimate_hours" />
                            <field name="technical_risk_impact_estimate_hours" />
                            <field name="business_risk_impact_estimate_hours" />
                        </group>
                        <group string="AMC Calculation">
                            <field name="code" />
                            <field name="calculation_factor" />
                            <field name="man_hours" />
                            <field name="base_price" />
                            <field name="technical_risk" />
                            <field name="business_risk" />
                            <field name="total" />
                            <field name="cost_estimation" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Calculation">
                            <field name="calculation">
                                <tree create="0" delete="0">
                                    <field name="sequence" widget="handle" />
                                    <field name="resource" />
                                    <field name="activity" sum="Total" optional="show" />
                                    <field name="baseline_costing" sum="Total" optional="show" />
                                    <field name="technical_risk_impact" sum="Total" optional="show" />
                                    <field name="business_risk_impact" sum="Total" optional="show" />
                                    <field name="costing" invisible="1" />
                                </tree>
                                <form create="0" edit="0" delete="0">
                                    <sheet>
                                        <div class="oe_title">
                                            <h1>
                                                <field name="resource" options="{'no_open': True}" />
                                            </h1>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="activity" />
                                                <field name="baseline_costing" />
                                            </group>
                                            <group>
                                                <field name="technical_risk_impact" />
                                                <field name="business_risk_impact" />
                                                <field name="costing" invisible="1" />
                                            </group>
                                        </group>
                                    </sheet>
                                    <div class="oe_chatter">
                                        <field name="message_follower_ids" />
                                        <field name="activity_ids" />
                                        <field name="message_ids" />
                                    </div>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="cost_estimation_costing_tree_view" model="ir.ui.view">
        <field name="name">Costing Tree View</field>
        <field name="model">cost_estimation.costing</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="sequence" widget="handle" />
                <field name="phase" />
                <field name="code" optional="show" />
                <field name="calculation_factor" optional="show" />
                <field name="activity_estimate_hours" sum="Total" optional="show" />
                <field name="technical_risk_impact_estimate_hours" sum="Total" optional="show" />
                <field name="business_risk_impact_estimate_hours" sum="Total" optional="show" />
                <field name="man_hours" sum="Total" optional="show" />
                <field name="base_price" sum="Total" optional="show" />
                <field name="technical_risk" sum="Total" optional="show" />
                <field name="business_risk" sum="Total" optional="show" />
                <field name="total" sum="Total" optional="show" />
                <field name="cost_estimation" invisible="1" />
            </tree>
        </field>
    </record>
</odoo>