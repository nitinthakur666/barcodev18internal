<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cost_estimation_factor_form_view" model="ir.ui.view">
        <field name="name">Factor Form View</field>
        <field name="model">cost_estimation.factor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type" />
                            <field name="description" />
                            <field name="general_hints" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="cost_estimation_factor_tree_view" model="ir.ui.view">
        <field name="name">Factor Tree View</field>
        <field name="model">cost_estimation.factor</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="type" optional="show" />
                <field name="description" optional="show" />
                <field name="general_hints" optional="show" />
            </list>
        </field>
    </record>

    <record id="action_factor" model="ir.actions.act_window">
        <field name="name">Factor</field>
        <field name="res_model">cost_estimation.factor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Factor
            </p>
        </field>
    </record>
</odoo>