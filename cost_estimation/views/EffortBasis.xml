<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cost_estimation_effort_basis_tree_view" model="ir.ui.view">
        <field name="name">Effort Basis Tree View</field>
        <field name="model">cost_estimation.effort_basis</field>
        <field name="arch" type="xml">
            <list create="0" editable="bottom" delete="0">
                <field name="sequence" widget="handle" />
                <field name="phase" readonly="1" options="{'no_open': True}" />
                <field name="estimated_man_days" sum="Total" optional="show" />
                <field name="correction_days" sum="Total" optional="show" groups="!barcode_india.group_barcode_india_cat_head" readonly="1"/>
                <field name="correction_days" sum="Total" optional="show" groups="barcode_india.group_barcode_india_cat_head"/>
                <field name="total_days" sum="Total" optional="show" />
                <field name="cost_estimation" column_invisible="1" />
            </list>
        </field>
    </record>
</odoo>