<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cost_estimation_project_cost_form_view" model="ir.ui.view">
        <field name="name">Project Cost Form View</field>
        <field name="model">cost_estimation.project_cost</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="phase" options="{'no_open': True}" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="man_hours" />
                            <field name="baseline_cost" />
                            <field name="technical_risk" />
                            <field name="business_risk" />
                        </group>
                        <group>
                            <field name="total_estimate" />
                            <field name="risk_buffered" widget="percentage" />
                            <field name="quotation_cost" invisible="1" />
                            <field name="cost_estimation" invisible="1" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="cost_estimation_project_cost_tree_view" model="ir.ui.view">
        <field name="name">Project Cost Tree View</field>
        <field name="model">cost_estimation.project_cost</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sequence" widget="handle" />
                <field name="phase" />
                <field name="man_hours" sum="Total" optional="show" />
                <field name="baseline_cost" sum="Total" optional="show" />
                <field name="technical_risk" sum="Total" optional="show" />
                <field name="business_risk" sum="Total" optional="show" />
                <field name="total_estimate" sum="Total" optional="show" />
                <field name="risk_buffered" avg="Total" widget="percentage" optional="show" />
                <field name="quotation_cost" column_invisible="1" />
                <field name="cost_estimation" column_invisible="1" />
            </list>
        </field>
    </record>
</odoo>