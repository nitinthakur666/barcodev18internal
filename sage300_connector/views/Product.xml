<odoo>
    <data>
        
        <record id="product_template_form_view_barcode" model="ir.ui.view">
            <field name="name">product.template.form.barcode</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="quantity_on_hand"/>
                    <field name="quantity_on_purchase_order"/>
                    <field name="quantity_on_sales_order"/>
                    <field name="last_sync_date" invisible="1"/>
                    <field name="pt_state" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="action_product_sync_final" model="ir.actions.act_window">
            <field name="name">Product Sync</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('pt_state','in',['pending'])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Synced product
                </p>
            </field>
        </record>
        
        <record id="action_product_sync" model="ir.actions.act_window">
            <field name="name">Product Sync</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Contacts
                </p>
            </field>
        </record>

        <record id="action_product_sync_pending" model="ir.actions.act_window">
            <field name="name">Product Sync</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('pt_state','in',['pending'])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Pending Contacts to Sync
                </p>
            </field>
        </record>

        <record id="action_product_sync_done" model="ir.actions.act_window">
            <field name="name">Product Sync</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('pt_state','in',['done'])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Synced Contacts
                </p>
            </field>
        </record>

        <record id="action_product_sync_failed" model="ir.actions.act_window">
            <field name="name">Product Sync</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('pt_state','in',['fail'])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Failed Contacts
                </p>
            </field>
        </record>


        <!-- Logs Views -->
        <record id="action_product_sync_logs" model="ir.actions.act_window">
        <field name="name">Product Sync Logs</field>
        <field name="res_model">sage300_connector.product_logs</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Product Sync Logs
            </p>
        </field>
    </record>

    <record id="product_sync_logs_form_view" model="ir.ui.view">
        <field name="name">Product Sync Logs</field>
        <field name="model">sage300_connector.product_logs</field>
        <field name="arch" type="xml">
            <form string="Logs">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <field name="ref" nolabel="1"/>
                    <field name="message" nolabel="1"/>
                    <field name="request" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="product_sync_logs_tree">
        <field name="name">Product Sync Logs</field>
        <field name="model">sage300_connector.product_logs</field>
        <field name="arch" type="xml">
            <list string="Logs">
                <field name="create_date"/>
                <field name="name"/>
                <field name="message"/>
                <field name="ref"/>   
            </list>
        </field>
    </record>

    <menuitem id="sage300_product_sub_menu" parent="sage300_connector_sub_menu" action="action_product_sync_logs" name="Product Sync Log"/>


    </data>
</odoo>