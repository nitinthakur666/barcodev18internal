<odoo>
	<record id="sage300_integration_action" model="ir.actions.act_window">
		<field name="name">Integration Dashboard</field>
		<field name="res_model">sage300_connector.integrations</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">kanban,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
			
			</p><p>
			
			</p>
		</field>
	</record>

	<record model="ir.ui.view" id="sage300_connector_integrations_form">
		<field name="name">sage300_connector.integrations.form</field>
		<field name="model">sage300_connector.integrations</field>
		<field name="arch" type="xml">
			<form string="Integrations">
				<sheet>
					<group>
						<group name="first">
							<!-- <field name="debug_mode" invisible="1"/> -->
							<!-- <field name="records" /> -->
							<field name="pending_records" />
							<field name="active_job"/>
							<field name="limit"/>
						</group>
						<group name="second">
							<field name="process" />
							<field name="sequence" />
							<field name="process_code" />
							<field name="cron_job"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record model="ir.ui.view" id="sage_integration_kanban">
		<field name="name">sage300.integration.kanban</field>
		<field name="model">sage300_connector.integrations</field>
		<field name="arch" type="xml">
			<kanban edit="false" class="o_kanban_mobile" group_create="0" records_draggable="0">
				<field name="name"/>
